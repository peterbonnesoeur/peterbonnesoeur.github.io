---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import TopoDivider from '../../components/TopoDivider.astro';

const generalTools = [
  {
    title: 'Markdown to LinkedIn',
    description: 'Convert markdown text to LinkedIn-formatted posts with bold/italic Unicode magic. Real-time preview.',
    href: '/tools/markdown-to-linkedin',
    icon: '📝',
  },
  {
    title: 'Notion to LinkedIn',
    description: 'Transform Notion-exported text into LinkedIn-ready formatting with checkboxes and headers.',
    href: '/tools/notion-to-linkedin',
    icon: '📋',
  },
];

const familyTools = [
  {
    title: 'Livraisons PDF → Excel',
    description: 'Convertit un PDF « Livraisons en cours » en fichier Excel mis en forme. Aperçu et correction avant téléchargement.',
    href: '/tools/livraisons-pdf',
    icon: '📦',
  },
  {
    title: 'Commandes expédiées → Excel',
    description: 'Convertit un PDF « Commandes expédiées » (en cours / reliquats / portefeuille) en fichier Excel propre. Aperçu modifiable.',
    href: '/tools/commandes-expediees',
    icon: '🚚',
  },
];
---

<BaseLayout title="Tools | Maxime Bonnesoeur" currentPath="/tools">
  <div class="max-w-4xl mx-auto px-6 py-24">
    <h1 class="text-4xl md:text-5xl font-heading text-slate dark:text-moonstone mb-4">Toolbox</h1>
    <p class="text-graphite dark:text-dim mb-12">Small utilities I built to scratch my own itch. Free to use.</p>

    <TopoDivider />

    <section class="mt-12">
      <h2 class="font-heading text-2xl text-slate dark:text-moonstone mb-2">General tools</h2>
      <p class="text-sm text-graphite dark:text-dim mb-6">Public utilities — useful for anyone writing or posting online.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {generalTools.map(tool => (
          <ToolCard {...tool} />
        ))}
      </div>
    </section>

    <div class="mt-16">
      <TopoDivider />
    </div>

    <section class="mt-12">
      <h2 class="font-heading text-2xl text-slate dark:text-moonstone mb-2">Outils famille</h2>
      <p class="text-sm text-graphite dark:text-dim mb-6">Petits utilitaires bricolés pour des besoins très spécifiques (PDF métier de ma mère). Probablement pas utiles pour vous, mais en libre accès.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {familyTools.map(tool => (
          <ToolCard {...tool} />
        ))}
      </div>
    </section>

    <!-- Hidden summit marker #3 -->
    <span class="summit-marker text-[6px] text-stone/30 dark:text-campfire-border/30 mt-8 inline-block cursor-pointer" data-summit="3" title="&#9650;">&#9650;</span>
  </div>
</BaseLayout>
